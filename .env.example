# 复制本文件为 .env 并填写真实值。.env 已被 .gitignore 排除，不会提交到仓库。
# config.py 会优先读取环境变量，其次读取项目根目录的 .env。

# 数据库连接（开发默认：本地 PostgreSQL）
# 打包版自动使用 exe 同目录的 SQLite，无需此项
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/blood_analysis

# JWT 签名密钥（生产环境必须改为强随机值，例如：
#   python -c "import secrets; print(secrets.token_urlsafe(64))" ）
JWT_SECRET=REPLACE_WITH_A_GENERATED_RANDOM_SECRET

# JWT 算法与有效期
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=720
